# Copy to configs/friend_server.local.env; this file is gitignored.
export CXR_DATA_ROOT=/authorized/data/cxr_first.zip
export CXR_PROTOCOL_DIR=/authorized/data/phase17_protocol
export CXR_OUTPUT_ROOT=/authorized/results
export CXR_PRETRAINED_ROOT=/authorized/torch_cache
export CXR_BACKUP_ROOT=/authorized/backup
export CXR_GPUS=0,1,2,3,4,5,6,7
export CXR_MAX_CONCURRENT=8
# Separate cap for the short real-data REMOTE_PREFLIGHT, including staged GPU probes.
export CXR_PREFLIGHT_GPU_HOURS=
export CXR_GPU_HOURS=
# G/H are PENDING and are never run by friend_start.sh.
